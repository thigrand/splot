{
  "manifest_version": 3,
  "name": "Splot — zapisz i zamknij",
  "version": "0.3.0",
  "description": "Zapisuje link i własny kontekst do lokalnego pliku JSON, a następnie bezpiecznie zamyka kartę.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "storage", "downloads", "offscreen"],
  "icons": {
    "16": "icons/splot-16.png",
    "32": "icons/splot-32.png",
    "48": "icons/splot-48.png",
    "128": "icons/splot-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/splot-16.png",
      "32": "icons/splot-32.png",
      "48": "icons/splot-48.png",
      "128": "icons/splot-128.png"
    },
    "default_title": "Splot — zapisz i zamknij",
    "default_popup": "popup.html"
  }
}
